{
  "name": "toolshop-playwright-automation",
  "version": "1.0.0",
  "private": true,
  "description": "Real Toolshop UI and API automation with Playwright and strict TypeScript",
  "license": "MIT",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "test": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "playwright test --grep @regression",
    "test:serial": "playwright test --project=chromium --project=api --workers=1",
    "test:parallel": "playwright test --project=chromium --project=api --workers=2",
    "test:smoke:parallel": "playwright test --project=chromium --project=api --grep @smoke --workers=2",
    "test:chromium": "playwright test --project=chromium",
    "test:firefox": "playwright test --project=firefox",
    "test:webkit": "playwright test --project=webkit",
    "test:headed": "playwright test --headed",
    "test:api": "playwright test --project=api",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^24.0.0",
    "allure-commandline": "^2.34.1",
    "allure-playwright": "^3.4.0",
    "dotenv": "^17.2.3",
    "eslint": "^10.13.0",
    "prettier": "^3.6.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0"
  }
}
